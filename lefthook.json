{
	"$schema": "https://raw.githubusercontent.com/evilmartians/lefthook/v2.0.9/schema.json",
	"assert_lefthook_installed": true,
	"min_version": "2.0.0",
	"commit-msg": {
		"commands": {
			"check": {
				"run": "pnpm commit:check --edit {1}",
				"env": {
					"LEFTHOOK": "0"
				}
			}
		}
	},
	"pre-commit": {
		"commands": {
			"check": {
				"glob": [
					"*.js",
					"*.ts",
					"*.cjs",
					"*.mjs",
					"*.d.cts",
					"*.d.mts",
					"*.jsx",
					"*.tsx",
					"*.json",
					"*.jsonc"
				],
				"run": "pnpm hooks:pre-commit:check {staged_files}",
				"stage_fixed": true
			}
		}
	},
	"pre-push": {
		"commands": {
			"check:type": {
				"run": "pnpm hooks:pre-push:check:type"
			},
			"check:lint": {
				"glob": [
					"*.js",
					"*.cjs",
					"*.mjs",
					"*.ts",
					"*.d.ts",
					"*.d.cts",
					"*.d.mts",
					"*.jsx",
					"*.tsx",
					"*.json",
					"*.jsonc"
				],
				"run": "pnpm hooks:pre-push:check:lint {push_files}"
			},
			"check:format": {
				"glob": [
					"*.js",
					"*.ts",
					"*.cjs",
					"*.mjs",
					"*.d.ts",
					"*.d.cts",
					"*.d.mts",
					"*.jsx",
					"*.tsx",
					"*.json",
					"*.jsonc"
				],
				"run": "pnpm hooks:pre-push:check:format {push_files}"
			},
			"test": {
				"glob": [
					"*.js",
					"*.ts",
					"*.cjs",
					"*.mjs",
					"*.d.ts",
					"*.d.cts",
					"*.d.mts",
					"*.jsx",
					"*.tsx"
				],
				"run": "pnpm hooks:pre-push:test"
			}
		}
	}
}
