// https://github.com/streetsidesoftware/cspell/tree/main/packages/cspell#example-cspelljson-file
{
	"$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
	"version": "0.2",
	"language": "en",
	"allowCompoundWords": true,
	"ignorePaths": [
		// Ignore node modules
		"**/node_modules/**",
		// Ignore GitHub configs
		"**/.github/**",
		// Ignore VSCode settings
		"**/.vscode/**",
		// Ignore test reports
		"**/reports/**",
		// Ignore meta-linter report
		"**/megalinter-reports/**",
		// Ignore dictionary files
		"**/*.dict.txt",
		// Ignore vscode workspace settings
		"**/*.code-workspace",
		// Ignore Pnpm lock file
		"**/pnpm-lock.yaml",
		// Ignore pnpm workspace file
		"**/pnpm-workspace.yaml",
		// Ignore dependencies and package file
		"**/package.json",
		// Ignore Typedoc config files
		"**/typedoc.json",
		"**/typedoc.*.json"
	],
	"dictionaries": [
		"en_US",
		"softwareTerms",
		"misc",
		"typescript",
		"node",
		"npm",
		"bash",
		"filetypes",
		"customDict"
	],
	"dictionaryDefinitions": [
		{ "name": "customDict", "path": "./cspell-custom.dict.txt" }
	],
	"useGitignore": true,
	"gitignoreRoot": "../.."
}
