{
	"$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json",
	"default": true,
	"MD004": {
		"style": "consistent"
	},
	"MD007": {
		"indent": 2
	},
	"MD012": {
		"enabled": true,
		"maximum": 2
	},
	"MD013": {
		"stern": true,
		"heading_line_length": 80,
		"line_length": 200,
		"code_block_line_length": 120,
		"tables": false
	},
	"MD024": {
		"enabled": true,
		"siblings_only": true
	},
	"MD033": false
}
