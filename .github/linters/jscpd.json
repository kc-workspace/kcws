{
	"$schema": "https://www.schemastore.org/jscpd.json",
	"threshold": 0,
	"reporters": ["html", "markdown"],
	"blame": true,
	"ignore": [
		"**/node_modules/**",
		"**/.git/**",
		"**/.rbenv/**",
		"**/.venv/**",
		"**/report/**",
		"**/megalinter-reports/**",
		"**/hardis-report/**",
		"**/*cache*/**",
		"**/.github/workflows/**",
		"**/.github/linters/**",
		"**/package.json",
		"**/pnpm-lock.yaml",
		"**/tsconfig.json",
		"**/tsdown.config.ts",
		"**/vitest.config.ts",
		"**/*.example.ts",
		"**/*.test.ts",
		"**/*.test.sh",
		"**/CHANGELOG.md",
		"**/AGENTS.md"
	]
}
