{
	"name": "@kcws/root",
	"version": "0.0.0-development",
	"private": true,
	"type": "module",
	"scripts": {
		"postinstall": "pnpm build:internal",
		"build:internal": "pnpm recursive run --if-present --stream --filter @kcinternals/* build",
		"build:config": "pnpm recursive run --if-present --stream --filter @kcconfigs/* build",
		"build:all": "pnpm recursive run --if-present --stream build",
		"test:all": "vitest run --configLoader native",
		"check:commit": "commitlint",
		"check:file": "ls-lint --config .github/linters/ls-lint.yaml",
		"check:all": "pnpm recursive run --if-present --stream check",
		"fix:all": "pnpm recursive run --if-present --stream fix",
		"docs:all": "typedoc",
		"clean": "rimraf --verbose --glob -- docs **/*.tsbuildinfo **/dist **/reports",
		"clean:all": "pnpm clean && rimraf --verbose --glob -- **/node_modules pnpm-lock.yaml",
		"commit": "git-cz"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.8",
		"@commitlint/cli": "21.2.1",
		"@commitlint/cz-commitlint": "21.2.0",
		"@kcconfigs/biome": "workspace:",
		"@kcconfigs/commitlint": "workspace:",
		"@kcconfigs/lefthook": "workspace:",
		"@kcconfigs/tsconfig": "workspace:",
		"@kcconfigs/typedoc": "workspace:",
		"@kcconfigs/vitest": "workspace:",
		"@ls-lint/ls-lint": "2.3.1",
		"@vitest/coverage-v8": "4.1.10",
		"@vitest/ui": "4.1.10",
		"commitizen": "4.3.2",
		"inquirer": "^12.11.1",
		"lefthook": "2.1.10",
		"rimraf": "6.1.3",
		"typedoc": "0.28.20",
		"typedoc-github-theme": "0.4.0",
		"typedoc-plugin-dt-links": "2.0.66",
		"typedoc-plugin-extras": "4.0.1",
		"typedoc-plugin-include-example": "3.0.2",
		"typedoc-plugin-mdn-links": "5.1.1",
		"typedoc-plugin-missing-exports": "4.1.4",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	},
	"config": {
		"commitizen": {
			"path": "@commitlint/cz-commitlint"
		}
	},
	"volta": {
		"node": "24.19.0"
	},
	"engines": {
		"node": "^22.11.0 || ^24.11.0 || ^25.0.0 || ^26.0.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.22.0",
			"onFail": "error"
		}
	}
}
