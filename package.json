{
	"name": "@kcws/root",
	"private": true,
	"scripts": {
		"build:all": "pnpm recursive run --if-present --stream build",
		"test:all": "pnpm recursive run --if-present --stream test",
		"check:all": "pnpm recursive run --if-present --stream check",
		"fix:all": "pnpm recursive run --if-present --stream fix",
		"docs:all": "typedoc",
		"clean": "rimraf --verbose --glob -- **/dist",
		"clean:all": "rimraf --verbose --glob -- **/dist **/node_modules pnpm-lock.yaml"
	},
	"devDependencies": {
		"@kcconfigs/tsconfig": "workspace:",
		"@kcconfigs/biome": "workspace:",
		"@biomejs/biome": "catalog:",
		"typedoc": "catalog:",
		"rimraf": "6.1.2"
	},
	"engines": {
		"node": ">=10",
		"pnpm": ">=3"
	},
	"packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a"
}
