{
	"name": "@kcws/root",
	"version": "0.0.0-development",
	"private": true,
	"scripts": {
		"postinstall": "pnpm run --filter '@kcconfigs/*' build",
		"build:all": "pnpm recursive run --if-present --stream build",
		"test:all": "vitest run",
		"check:all": "pnpm recursive run --if-present --stream check",
		"fix:all": "pnpm recursive run --if-present --stream fix",
		"docs:all": "typedoc",
		"clean": "rimraf --verbose --glob -- **/dist docs reports",
		"clean:all": "pnpm clean && rimraf --verbose --glob -- **/node_modules pnpm-lock.yaml",
		"commit": "git-cz",
		"commit:check": "commitlint",
		"hooks:pre-commit:check": "pnpm biome check --fix --unsafe --no-errors-on-unmatched --colors=off",
		"hooks:pre-push:check:type": "pnpm recursive run --if-present --stream type:check",
		"hooks:pre-push:check:lint": "pnpm biome lint --no-errors-on-unmatched --colors=off",
		"hooks:pre-push:check:format": "pnpm biome format --no-errors-on-unmatched --colors=off",
		"hooks:pre-push:test": "vitest run --no-color"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@commitlint/cli": "catalog:commitlint",
		"@commitlint/cz-commitlint": "catalog:commitlint",
		"@kcconfigs/biome": "workspace:",
		"@kcconfigs/commitlint": "workspace:",
		"@kcconfigs/tsconfig": "workspace:",
		"@kcconfigs/vitest": "workspace:",
		"@vitest/coverage-v8": "catalog:",
		"@vitest/ui": "catalog:",
		"commitizen": "catalog:commitlint",
		"inquirer": "catalog:commitlint",
		"lefthook": "catalog:",
		"rimraf": "6.1.2",
		"typedoc": "catalog:",
		"typedoc-plugin-dt-links": "catalog:",
		"typedoc-plugin-extras": "catalog:",
		"typedoc-plugin-include-example": "catalog:",
		"typedoc-plugin-mdn-links": "catalog:",
		"typedoc-plugin-missing-exports": "catalog:",
		"varvara-typedoc-theme": "0.3.8",
		"vitest": "catalog:"
	},
	"config": {
		"commitizen": {
			"path": "@commitlint/cz-commitlint"
		}
	},
	"engines": {
		"node": "22.21.1"
	},
	"packageManager": "pnpm@10.25.0+sha512.5e82639027af37cf832061bcc6d639c219634488e0f2baebe785028a793de7b525ffcd3f7ff574f5e9860654e098fe852ba8ac5dd5cefe1767d23a020a92f501"
}
