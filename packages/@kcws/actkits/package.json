{
	"name": "@kcws/actkits",
	"version": "0.1.7",
	"description": "Shared GitHub Actions Toolkits",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"fix": "biome check --fix --unsafe",
		"check": "pnpm run lint:check && pnpm run format:check && pnpm run type:check",
		"format": "biome format --fix",
		"format:check": "biome format",
		"lint": "biome lint --fix --unsafe",
		"lint:check": "biome lint",
		"type:check": "tsc --noEmit"
	},
	"dependencies": {
		"zod": "4.4.3",
		"yaml": "2.9.0",
		"@actions/core": "3.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@kcconfigs/biome": "workspace:*",
		"@kcconfigs/vitest": "workspace:*",
		"@kcconfigs/tsconfig": "workspace:*",
		"@kcconfigs/tsdown": "workspace:*",
		"tsdown": "0.22.14",
		"vitest": "4.1.10"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"typedoc": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./*": {
			"source": "./src/*/index.ts",
			"typedoc": "./src/*/index.ts",
			"types": "./dist/*/index.d.ts",
			"import": "./dist/*/index.js"
		}
	},
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/kc-workspace/kcws/tree/main/packages/@kcws/actkits",
	"repository": {
		"type": "git",
		"directory": "@kcws/actkits",
		"url": "git+https://github.com/kc-workspace/kcws.git"
	},
	"author": {
		"name": "Kamontat Chantrachirathumrong",
		"email": "kcws@kc.in.th",
		"url": "https://github.com/kamontat"
	},
	"keywords": [
		"github",
		"github-actions",
		"actions",
		"toolkit"
	],
	"files": [
		"CHANGELOG.json",
		"CHANGELOG.md",
		"dist",
		"src",
		"!*.test.*"
	],
	"engines": {
		"node": ">=14"
	},
	"publishConfig": {
		"access": "public"
	}
}
