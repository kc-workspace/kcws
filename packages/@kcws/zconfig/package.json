{
	"private": false,
	"name": "@kcws/zconfig",
	"version": "0.1.0",
	"description": "Load type-safe configuration with Zod schema",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"fix": "biome check --fix --unsafe",
		"check": "pnpm run lint:check && pnpm run format:check && pnpm run type:check",
		"format": "biome format --fix",
		"format:check": "biome format",
		"lint": "biome lint --fix --unsafe",
		"lint:check": "biome lint",
		"type:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@kcconfigs/biome": "workspace:*",
		"@kcconfigs/vitest": "workspace:*",
		"@kcconfigs/tsconfig": "workspace:*",
		"@kcconfigs/tsdown": "workspace:*",
		"tsdown": "0.22.14",
		"vitest": "4.1.10"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"typedoc": "./src/index.ts",
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/kc-workspace/kcws/tree/main/packages/@kcws/zconfig",
	"repository": {
		"type": "git",
		"directory": "@kcws/zconfig",
		"url": "git+https://github.com/kc-workspace/kcws.git"
	},
	"author": {
		"name": "Kamontat Chantrachirathumrong",
		"email": "kcws@kc.in.th",
		"url": "https://github.com/kamontat"
	},
	"keywords": [
		"config",
		"configuration",
		"zod",
		"schema",
		"json",
		"yaml",
		"toml",
		"typescript",
		"javascript",
		"environment",
		"dotenv"
	],
	"files": [
		"CHANGELOG.json",
		"CHANGELOG.md",
		"dist",
		"src",
		"!*.test.*"
	],
	"engines": {
		"node": ">=14"
	},
	"publishConfig": {
		"access": "public"
	}
}
