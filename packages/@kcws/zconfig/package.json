{
	"name": "@kcws/zconfig",
	"version": "0.2.7",
	"description": "Load type-safe configuration with Zod schema",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"test": "vitest run --configLoader native",
		"bench": "vitest bench --run --configLoader native",
		"fix": "biome check --fix --unsafe",
		"fix:lint": "biome lint --fix --unsafe",
		"fix:format": "biome format --fix",
		"check": "pnpm run check:lint && pnpm run check:format && pnpm run check:type",
		"check:lint": "biome lint",
		"check:format": "biome format",
		"check:type": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@kcconfigs/biome": "workspace:*",
		"@kcconfigs/tsconfig": "workspace:*",
		"@kcconfigs/tsdown": "workspace:*",
		"@kcconfigs/vitest": "workspace:*",
		"dotenv": "18.0.6",
		"json5": "2.2.3",
		"jsonc-parser": "3.3.1",
		"smol-toml": "1.9.0",
		"tsdown": "0.23.0",
		"vitest": "5.0.3",
		"yaml": "2.9.1",
		"zod": "4.6.5"
	},
	"peerDependencies": {
		"dotenv": "^17.0.0 || ^18.0.0",
		"json5": "^2.2.0",
		"jsonc-parser": "^3.3.0",
		"smol-toml": "^1.8.0",
		"yaml": "^2.8.3",
		"zod": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"dotenv": {
			"optional": true
		},
		"json5": {
			"optional": true
		},
		"jsonc-parser": {
			"optional": true
		},
		"smol-toml": {
			"optional": true
		},
		"yaml": {
			"optional": true
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"typedoc": "./src/index.ts",
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./adapters": {
			"source": "./src/adapters/index.ts",
			"typedoc": "./src/adapters/index.ts",
			"require": {
				"types": "./dist/adapters/index.d.cts",
				"default": "./dist/adapters/index.cjs"
			},
			"default": {
				"types": "./dist/adapters/index.d.ts",
				"default": "./dist/adapters/index.js"
			}
		},
		"./adapters/*": {
			"source": "./src/adapters/*/index.ts",
			"typedoc": "./src/adapters/*/index.ts",
			"require": {
				"types": "./dist/adapters/*/index.d.cts",
				"default": "./dist/adapters/*/index.cjs"
			},
			"default": {
				"types": "./dist/adapters/*/index.d.ts",
				"default": "./dist/adapters/*/index.js"
			}
		}
	},
	"imports": {
		"#core": "./src/core/index.ts",
		"#types": "./src/types/index.ts",
		"#utils/*": "./src/utils/*/index.ts"
	},
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/kc-workspace/kcws/tree/main/packages/@kcws/zconfig",
	"repository": {
		"type": "git",
		"directory": "@kcws/zconfig",
		"url": "git+https://github.com/kc-workspace/kcws.git"
	},
	"author": {
		"name": "Kamontat Chantrachirathumrong",
		"email": "kcws@kc.in.th",
		"url": "https://github.com/kamontat"
	},
	"keywords": [
		"config",
		"configuration",
		"zod",
		"schema",
		"json",
		"yaml",
		"toml",
		"typescript",
		"javascript",
		"environment",
		"dotenv"
	],
	"files": [
		"CHANGELOG.json",
		"CHANGELOG.md",
		"dist",
		"src",
		"!*.test.*",
		"!*.bench.*"
	],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	}
}
