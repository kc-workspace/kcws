{
	"name": "@kcexamples/demo",
	"version": "0.1.0-beta.0",
	"description": "Demo library for testing various tools.",
	"type": "module",
	"scripts": {
		"build": "pnpm run build:all",
		"build:dts": "tsc --project tsconfig.dts.json",
		"build:vite": "pnpm run build:vite:mjs && pnpm run build:vite:cjs",
		"build:vite:mjs": "vite build --config vite-mjs.config.ts",
		"build:vite:cjs": "vite build --config vite-cjs.config.ts",
		"build:tsdown": "tsdown",
		"build:zshy": "zshy --project tsconfig.zshy.json",
		"build:all": "pnpm run build:dts && pnpm run build:vite && pnpm run build:tsdown && pnpm run build:zshy",
		"test": "vitest run --configLoader native",
		"fix": "biome check --fix --unsafe",
		"fix:lint": "biome lint --fix --unsafe",
		"fix:format": "biome format --fix",
		"check": "pnpm run check:lint && pnpm run check:format && pnpm run check:type",
		"check:lint": "biome lint",
		"check:format": "biome format",
		"check:type": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@kcconfigs/biome": "workspace:*",
		"@kcconfigs/vitest": "workspace:*",
		"@kcconfigs/tsconfig": "workspace:*",
		"@kcconfigs/tsdown": "workspace:*",
		"rolldown-plugin-dts": "0.28.0",
		"tsdown": "0.22.7",
		"vite": "8.2.1",
		"vitest": "4.1.10",
		"zshy": "0.7.3"
	},
	"zshy": {
		"exports": "./src/index.ts",
		"noEdit": true
	},
	"main": "./dist.tsdown/index.js",
	"types": "./dist.tsdown/index.d.cts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"typedoc": "./src/index.ts",
			"require": {
				"types": "./dist.tsdown/index.d.cts",
				"default": "./dist.tsdown/index.cjs"
			},
			"default": {
				"types": "./dist.tsdown/index.d.ts",
				"default": "./dist.tsdown/index.js"
			}
		}
	},
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/kc-workspace/kcws/tree/main/packages/@kcexamples/demo",
	"repository": {
		"type": "git",
		"directory": "@kcexamples/demo",
		"url": "git+https://github.com/kc-workspace/kcws.git"
	},
	"author": {
		"name": "Kamontat Chantrachirathumrong",
		"email": "kcws@kc.in.th",
		"url": "https://github.com/kamontat"
	},
	"keywords": [
		"example",
		"testing",
		"build",
		"typescript",
		"zshy",
		"tsdown",
		"vite",
		"tsc"
	],
	"files": [
		"CHANGELOG.json",
		"CHANGELOG.md",
		"dist.tsc",
		"dist.tsdown",
		"dist.vite",
		"dist.zshy",
		"!*.test.*"
	],
	"engines": {
		"node": ">=14"
	},
	"publishConfig": {
		"access": "public"
	}
}
