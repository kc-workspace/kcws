{
	"name": "@kctools/bun-server",
	"version": "0.3.0",
	"description": "Use bun to start dev or prod server for simple website",
	"private": false,
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"start": "./bin/index.js",
		"build-start": "pnpm build && ./bin/index.js",
		"test": "vitest run --configLoader native",
		"fix": "biome check --fix --unsafe",
		"fix:lint": "biome lint --fix --unsafe",
		"fix:format": "biome format --fix",
		"check": "pnpm run check:lint && pnpm run check:format && pnpm run check:type",
		"check:lint": "biome lint",
		"check:format": "biome format",
		"check:type": "tsc --noEmit"
	},
	"dependencies": {
		"@types/bun": "1.3.14",
		"commander": "15.0.0",
		"pino": "10.3.1",
		"pino-pretty": "13.1.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@kcconfigs/biome": "workspace:*",
		"@kcconfigs/tsconfig": "workspace:*",
		"@kcconfigs/tsdown": "workspace:*",
		"@kcconfigs/vitest": "workspace:*",
		"tsdown": "0.22.7",
		"vitest": "4.1.11"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"bun-server": "./bin/index.js"
	},
	"imports": {
		"#root/package.json": "./package.json",
		"#core/program": "./src/core/program.ts",
		"#commands/*": "./src/commands/*/index.ts",
		"#constants": "./src/constants/index.ts",
		"#utils/*": "./src/utils/*/index.ts",
		"#types": "./src/types/index.ts"
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"typedoc": "./src/index.ts",
			"default": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/kc-workspace/kcws/tree/main/packages/@kctools/bun-server",
	"repository": {
		"type": "git",
		"directory": "@kctools/bun-server",
		"url": "git+https://github.com/kc-workspace/kcws.git"
	},
	"author": {
		"name": "Kamontat Chantrachirathumrong",
		"email": "kcws@kc.in.th",
		"url": "https://github.com/kamontat"
	},
	"keywords": [
		"website",
		"bun",
		"bunjs",
		"server"
	],
	"files": [
		"CHANGELOG.json",
		"CHANGELOG.md",
		"dist",
		"src",
		"!*.test.*"
	],
	"engines": {
		"node": ">=14",
		"bun": ">=1.3"
	},
	"publishConfig": {
		"access": "public"
	}
}
