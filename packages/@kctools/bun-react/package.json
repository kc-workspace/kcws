{
	"name": "@kctools/bun-react",
	"version": "0.0.0-beta.0",
	"description": "Use bun to start dev or prod server for react website",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"start": "./bin/index.js",
		"build-start": "pnpm build && ./bin/index.js",
		"test": "vitest run",
		"fix": "biome check --fix --unsafe",
		"check": "pnpm run lint:check && pnpm run format:check && pnpm run type:check",
		"format": "biome format --fix",
		"format:check": "biome format",
		"lint": "biome lint --fix --unsafe",
		"lint:check": "biome lint",
		"type:check": "tsc --noEmit"
	},
	"dependencies": {
		"@types/bun": "1.3.11",
		"bun-plugin-tailwind": "0.1.2",
		"commander": "14.0.3"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@kcconfigs/biome": "workspace:*",
		"@kcconfigs/tsconfig": "workspace:*",
		"@kcconfigs/tsdown": "workspace:*",
		"@kcconfigs/vitest": "workspace:*",
		"tsdown": "catalog:",
		"vitest": "catalog:test:latest"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"bin": {
		"bun-react": "./bin/index.js"
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"typedoc": "./src/index.ts",
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/kc-workspace/kcws/tree/main/packages/@kctools/bun-react",
	"repository": {
		"type": "git",
		"directory": "@kctools/bun-react",
		"url": "git+https://github.com/kc-workspace/kcws.git"
	},
	"author": {
		"name": "Kamontat Chantrachirathumrong",
		"email": "kcws@kc.in.th",
		"url": "https://github.com/kamontat"
	},
	"keywords": [
		"react",
		"website",
		"bun",
		"bunjs",
		"server"
	],
	"files": [
		"CHANGELOG.json",
		"CHANGELOG.md",
		"dist",
		"src"
	],
	"engines": {
		"node": ">=14"
	},
	"publishConfig": {
		"access": "public"
	}
}
