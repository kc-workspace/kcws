{
	"$schema": "https://typedoc.org/schema.json",

	// Input: https://typedoc.org/documents/Options.Input.html
	"includeVersion": true,

	// Output: https://typedoc.org/documents/Options.Output.html
	"emit": "docs",
	"sourceLinkExternal": true,
	"markdownLinkExternal": true,
	"cleanOutputDir": true,
	// NOTE: This might increase search index
	"searchInDocuments": true,
	// NOTE: This might increase search index
	"searchInComments": true,

	// Comments: https://typedoc.org/documents/Options.Comments.html
	"useTsLinkResolution": true,

	// Organization: https://typedoc.org/documents/Options.Organization.html
	"categorizeByGroup": true,
	"sort": [
		"visibility",
		"static-first",
		"enum-value-ascending",
		"alphabetical-ignoring-documents"
	],
	"kindSortOrder": [
		"Reference",
		"Project",
		"Module",
		"Namespace",
		"Enum",
		"EnumMember",
		"Class",
		"Interface",
		"TypeAlias",
		"Constructor",
		"Property",
		"Variable",
		"Function",
		"Accessor",
		"Method",
		"Parameter",
		"TypeParameter",
		"TypeLiteral",
		"CallSignature",
		"ConstructorSignature",
		"IndexSignature",
		"GetSignature",
		"SetSignature"
	],

	// Validation: https://typedoc.org/documents/Options.Validation.html
	"validation": {
		"notExported": true,
		"invalidLink": true,
		"invalidPath": true,
		"rewrittenLink": true,
		"notDocumented": false,
		"unusedMergeModuleWith": true
	},
	"treatWarningsAsErrors": false,
	"treatValidationWarningsAsErrors": false
	// "requiredToBeDocumented": [
	//   "Namespace",
	//   "Enum",
	//   "EnumMember",
	//   "Function",
	//   "Class",
	//   "Method",
	//   "Reference"
	// ],

	// Other: https://typedoc.org/documents/Options.Other.html
}
