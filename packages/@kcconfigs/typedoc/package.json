{
	"name": "@kcconfigs/typedoc",
	"version": "0.1.0-beta.0",
	"description": "Shared typedoc configuration",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"fix": "biome check --fix --unsafe",
		"check": "pnpm run lint:check && pnpm run format:check && pnpm run type:check",
		"format": "biome format --fix",
		"format:check": "biome format",
		"lint": "biome lint --fix --unsafe",
		"lint:check": "biome lint",
		"type:check": "tsc --build"
	},
	"dependencies": {
		"typedoc": "catalog:typedoc:latest"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@kcconfigs/biome": "workspace:*",
		"@kcconfigs/tsconfig": "workspace:*",
		"@kcconfigs/tsdown": "workspace:*",
		"@kcconfigs/vitest": "workspace:*",
		"tsdown": "catalog:",
		"vitest": "catalog:test:latest"
	},
	"peerDependencies": {
		"typedoc": "catalog:typedoc:peer",
		"typedoc-github-theme": "catalog:typedoc:peer",
		"typedoc-material-theme": "catalog:typedoc:peer",
		"typedoc-theme-oxide": "catalog:typedoc:peer",
		"typedoc-rhineai-theme": "catalog:typedoc:peer",
		"varvara-typedoc-theme": "catalog:typedoc:peer",
		"typedoc-plugin-dt-links": "catalog:typedoc:peer",
		"typedoc-plugin-extras": "catalog:typedoc:peer",
		"typedoc-plugin-include-example": "catalog:typedoc:peer",
		"typedoc-plugin-mdn-links": "catalog:typedoc:peer",
		"typedoc-plugin-missing-exports": "catalog:typedoc:peer"
	},
	"peerDependenciesMeta": {
		"typedoc-github-theme": {
			"optional": true
		},
		"typedoc-material-theme": {
			"optional": true
		},
		"typedoc-theme-oxide": {
			"optional": true
		},
		"typedoc-rhineai-theme": {
			"optional": true
		},
		"varvara-typedoc-theme": {
			"optional": true
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"typedoc": "./src/index.ts",
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./*": {
			"source": "./src/presets/*.ts",
			"typedoc": "./src/presets/*.ts",
			"require": {
				"types": "./dist/presets/*.d.cts",
				"default": "./dist/presets/*.cjs"
			},
			"default": {
				"types": "./dist/presets/*.d.ts",
				"default": "./dist/presets/*.js"
			}
		},
		"./plugins/*": {
			"source": "./src/plugins/*.ts",
			"typedoc": "./src/plugins/*.ts",
			"require": {
				"types": "./dist/plugins/*.d.cts",
				"default": "./dist/plugins/*.cjs"
			},
			"default": {
				"types": "./dist/plugins/*.d.ts",
				"default": "./dist/plugins/*.js"
			}
		},
		"./themes/*": {
			"source": "./src/themes/*.ts",
			"typedoc": "./src/themes/*.ts",
			"require": {
				"types": "./dist/themes/*.d.cts",
				"default": "./dist/themes/*.cjs"
			},
			"default": {
				"types": "./dist/themes/*.d.ts",
				"default": "./dist/themes/*.js"
			}
		}
	},
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/kc-workspace/kcws/tree/main/packages/@kcconfigs/typedoc",
	"repository": {
		"type": "git",
		"directory": "@kcconfigs/typedoc",
		"url": "git+https://github.com/kc-workspace/kcws.git"
	},
	"author": {
		"name": "Kamontat Chantrachirathumrong",
		"email": "kcws@kc.in.th",
		"url": "https://github.com/kamontat"
	},
	"keywords": [
		"typedoc",
		"doc",
		"document",
		"documentation",
		"typescript",
		"config"
	],
	"files": [
		"CHANGELOG.json",
		"CHANGELOG.md",
		"dist",
		"src"
	],
	"engines": {
		"node": ">=14"
	},
	"publishConfig": {
		"access": "public"
	}
}
