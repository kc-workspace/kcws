{
	"name": "@kcconfigs/typedoc",
	"version": "0.3.2",
	"description": "Shared typedoc configuration",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"fix": "biome check --fix --unsafe",
		"fix:lint": "biome lint --fix --unsafe",
		"fix:format": "biome format --fix",
		"check": "pnpm run check:lint && pnpm run check:format && pnpm run check:type",
		"check:lint": "biome lint",
		"check:format": "biome format",
		"check:type": "tsc --noEmit"
	},
	"dependencies": {
		"typedoc": "0.28.20"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@kcconfigs/biome": "workspace:*",
		"@kcconfigs/tsconfig": "workspace:*",
		"@kcconfigs/tsdown": "workspace:*",
		"@kcconfigs/vitest": "workspace:*",
		"tsdown": "0.22.7",
		"vitest": "4.1.10"
	},
	"peerDependencies": {
		"typedoc": "^0.28.0",
		"typedoc-github-theme": "^0.3.0",
		"typedoc-material-theme": "^1.0.0",
		"typedoc-theme-oxide": "^0.2.0",
		"typedoc-rhineai-theme": "^1.0.0",
		"typedoc-plugin-dt-links": "^2.0.0",
		"typedoc-plugin-extras": "^4.0.0",
		"typedoc-plugin-include-example": "^3.0.0",
		"typedoc-plugin-mdn-links": "^5.0.0",
		"typedoc-plugin-missing-exports": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"typedoc-github-theme": {
			"optional": true
		},
		"typedoc-material-theme": {
			"optional": true
		},
		"typedoc-theme-oxide": {
			"optional": true
		},
		"typedoc-rhineai-theme": {
			"optional": true
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"typedoc": "./src/index.ts",
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./*": {
			"source": "./src/presets/*.ts",
			"typedoc": "./src/presets/*.ts",
			"require": {
				"types": "./dist/presets/*.d.cts",
				"default": "./dist/presets/*.cjs"
			},
			"default": {
				"types": "./dist/presets/*.d.ts",
				"default": "./dist/presets/*.js"
			}
		},
		"./plugins/*": {
			"source": "./src/plugins/*.ts",
			"typedoc": "./src/plugins/*.ts",
			"require": {
				"types": "./dist/plugins/*.d.cts",
				"default": "./dist/plugins/*.cjs"
			},
			"default": {
				"types": "./dist/plugins/*.d.ts",
				"default": "./dist/plugins/*.js"
			}
		},
		"./themes/*": {
			"source": "./src/themes/*.ts",
			"typedoc": "./src/themes/*.ts",
			"require": {
				"types": "./dist/themes/*.d.cts",
				"default": "./dist/themes/*.cjs"
			},
			"default": {
				"types": "./dist/themes/*.d.ts",
				"default": "./dist/themes/*.js"
			}
		}
	},
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/kc-workspace/kcws/tree/main/packages/@kcconfigs/typedoc",
	"repository": {
		"type": "git",
		"directory": "@kcconfigs/typedoc",
		"url": "git+https://github.com/kc-workspace/kcws.git"
	},
	"author": {
		"name": "Kamontat Chantrachirathumrong",
		"email": "kcws@kc.in.th",
		"url": "https://github.com/kamontat"
	},
	"keywords": [
		"typedoc",
		"doc",
		"document",
		"documentation",
		"typescript",
		"config"
	],
	"files": [
		"CHANGELOG.json",
		"CHANGELOG.md",
		"dist",
		"src",
		"!*.test.*"
	],
	"engines": {
		"node": ">=14"
	},
	"publishConfig": {
		"access": "public"
	}
}
