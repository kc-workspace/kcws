{
	"$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 120,
		"attributePosition": "auto",
		"lineEnding": "lf",
		"trailingNewline": true,
		"bracketSpacing": true,
		"bracketSameLine": false,
		"expand": "auto"
	},
	"linter": {
		"enabled": true,
		"domains": {
			"test": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"complexity": {
				"useLiteralKeys": {
					"level": "off",
					"fix": "none"
				}
			}
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"recommended": true,
				"organizeImports": {
					"level": "on",
					"options": {
						"identifierOrder": "natural",
						"groups": [
							{ "type": true },
							":BLANK_LINE:",
							[":NODE:", ":BUN:"],
							[":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:", ":URL:"],
							":BLANK_LINE:",
							[":ALIAS:", ":PATH:"]
						]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "asNeeded",
			"bracketSameLine": true
		}
	},
	"html": {
		"formatter": {
			"bracketSameLine": true
		}
	},
	"yaml": {
		"formatter": {
			"bracketSpacing": false
		}
	},
	"overrides": [
		{
			"includes": ["**/package.json"],
			"formatter": {
				"expand": "always"
			}
		},
		{
			"includes": ["**/*.md"],
			"formatter": {
				"indentStyle": "space",
				"indentWidth": 2
			}
		}
	]
}
