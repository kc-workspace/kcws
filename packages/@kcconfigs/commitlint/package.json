{
	"name": "@kcconfigs/commitlint",
	"version": "0.1.0-beta.0",
	"description": "Shared commitlint configuration",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"fix": "biome check --fix --unsafe",
		"check": "pnpm run lint:check && pnpm run format:check && pnpm run type:check",
		"format": "biome format --fix",
		"format:check": "biome format",
		"lint": "biome lint --fix --unsafe",
		"lint:check": "biome lint",
		"type:check": "tsc --build"
	},
	"dependencies": {
		"@pnpm/workspace.find-packages": "1000.0.49",
		"yaml": "2.8.2"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@commitlint/config-conventional": "catalog:commitlint:latest",
		"@commitlint/types": "catalog:commitlint:latest",
		"@kcconfigs/biome": "workspace:*",
		"@kcconfigs/tsconfig": "workspace:*",
		"@kcconfigs/tsdown": "workspace:*",
		"@kcconfigs/vitest": "workspace:*",
		"tsdown": "catalog:",
		"vitest": "catalog:test:latest"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"typedoc": "./src/index.ts",
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/kc-workspace/kcws/tree/main/packages/@kcconfigs/commitlint",
	"repository": {
		"type": "git",
		"directory": "@kcconfigs/commitlint",
		"url": "git+https://github.com/kc-workspace/kcws.git"
	},
	"author": {
		"name": "Kamontat Chantrachirathumrong",
		"email": "kcws@kc.in.th",
		"url": "https://github.com/kamontat"
	},
	"keywords": [
		"config",
		"typescript",
		"commitlint",
		"commit",
		"linter"
	],
	"files": [
		"CHANGELOG.json",
		"CHANGELOG.md",
		"dist",
		"src"
	],
	"engines": {
		"node": ">=14"
	},
	"publishConfig": {
		"access": "public"
	}
}
