{
	"name": "@kcconfigs/textlint",
	"version": "0.1.1",
	"description": "Shared textlint rule configuration",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"fix": "biome check --fix --unsafe",
		"check": "pnpm run lint:check && pnpm run format:check && pnpm run type:check",
		"format": "biome format --fix",
		"format:check": "biome format",
		"lint": "biome lint --fix --unsafe",
		"lint:check": "biome lint",
		"type:check": "tsc --noEmit"
	},
	"dependencies": {
		"textlint-filter-rule-allowlist": "catalog:textlint:latest",
		"textlint-filter-rule-comments": "catalog:textlint:latest",
		"textlint-rule-terminology": "catalog:textlint:latest"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@kcconfigs/biome": "workspace:*",
		"@kcconfigs/vitest": "workspace:*",
		"@kcconfigs/tsconfig": "workspace:*",
		"@kcconfigs/tsdown": "workspace:*",
		"tsdown": "catalog:",
		"vitest": "catalog:test:latest"
	},
	"peerDependencies": {
		"textlint": "catalog:textlint:peer"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"typedoc": "./src/index.ts",
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./preset-*": {
			"source": "./src/presets/*.ts",
			"typedoc": "./src/presets/*.ts",
			"require": {
				"types": "./dist/presets/*.d.cts",
				"default": "./dist/presets/*.cjs"
			},
			"default": {
				"types": "./dist/presets/*.d.ts",
				"default": "./dist/presets/*.js"
			}
		}
	},
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/kc-workspace/kcws/tree/main/packages/@kcconfigs/textlint",
	"repository": {
		"type": "git",
		"directory": "@kcconfigs/textlint",
		"url": "git+https://github.com/kc-workspace/kcws.git"
	},
	"author": {
		"name": "Kamontat Chantrachirathumrong",
		"email": "kcws@kc.in.th",
		"url": "https://github.com/kamontat"
	},
	"keywords": [
		"textlint",
		"textlintrule",
		"config",
		"preset"
	],
	"files": [
		"CHANGELOG.json",
		"CHANGELOG.md",
		"dist",
		"src"
	],
	"engines": {
		"node": ">=14"
	},
	"publishConfig": {
		"access": "public"
	}
}
