{
	"name": "@kcconfigs/vitest",
	"version": "0.3.0",
	"description": "Shared vitest configuration",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"test": "vitest run --configLoader native",
		"fix": "biome check --fix --unsafe",
		"fix:lint": "biome lint --fix --unsafe",
		"fix:format": "biome format --fix",
		"check": "pnpm run check:lint && pnpm run check:format && pnpm run check:type",
		"check:lint": "biome lint",
		"check:format": "biome format",
		"check:type": "tsc --noEmit"
	},
	"dependencies": {
		"@kcinternals/config-builder": "workspace:*",
		"memfs": "4.68.0",
		"vitest": "4.1.10"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.8",
		"@kcconfigs/tsconfig": "workspace:*",
		"@kcconfigs/tsdown": "workspace:*",
		"@kcconfigs/biome": "workspace:*",
		"@kctypes/generic": "workspace:*",
		"tsdown": "0.22.7"
	},
	"peerDependencies": {
		"vitest": "^4.0.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"typedoc": "./src/index.ts",
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./plugins": {
			"source": "./src/plugins/index.ts",
			"typedoc": "./src/plugins/index.ts",
			"require": {
				"types": "./dist/plugins/index.d.cts",
				"default": "./dist/plugins/index.cjs"
			},
			"default": {
				"types": "./dist/plugins/index.d.ts",
				"default": "./dist/plugins/index.js"
			}
		},
		"./plugins/*": {
			"source": "./src/plugins/*.ts",
			"typedoc": "./src/plugins/*.ts",
			"require": {
				"types": "./dist/plugins/*.d.cts",
				"default": "./dist/plugins/*.cjs"
			},
			"default": {
				"types": "./dist/plugins/*.d.ts",
				"default": "./dist/plugins/*.js"
			}
		},
		"./mocks": {
			"source": "./src/mockHelpers/index.ts",
			"require": {
				"types": "./dist/mockHelpers/index.d.cts",
				"default": "./dist/mockHelpers/index.cjs"
			},
			"default": {
				"types": "./dist/mockHelpers/index.d.ts",
				"default": "./dist/mockHelpers/index.js"
			}
		}
	},
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/kc-workspace/kcws/tree/main/packages/@kcconfigs/vitest",
	"repository": {
		"type": "git",
		"directory": "@kcconfigs/vitest",
		"url": "git+https://github.com/kc-workspace/kcws.git"
	},
	"author": {
		"name": "Kamontat Chantrachirathumrong",
		"email": "kcws@kc.in.th",
		"url": "https://github.com/kamontat"
	},
	"keywords": [
		"config",
		"typescript",
		"vitest",
		"test"
	],
	"files": [
		"CHANGELOG.json",
		"CHANGELOG.md",
		"dist",
		"src",
		"mocks",
		"!*.test.*"
	],
	"engines": {
		"node": ">=14"
	},
	"publishConfig": {
		"access": "public"
	}
}
