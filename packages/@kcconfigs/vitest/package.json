{
	"name": "@kcconfigs/vitest",
	"version": "0.1.0-beta.0",
	"description": "Common vitest configuration for kc's",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"fix": "biome check --fix --unsafe",
		"check": "pnpm run lint:check && pnpm run format:check && pnpm run type:check",
		"format": "biome format --fix",
		"format:check": "biome format",
		"lint": "biome lint --fix --unsafe",
		"lint:check": "biome lint",
		"type:check": "tsc --build"
	},
	"dependencies": {
		"vitest": "catalog:test:latest",
		"memfs": "catalog:test:latest"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@kcconfigs/tsconfig": "workspace:*",
		"@kcconfigs/tsdown": "workspace:*",
		"@kcconfigs/biome": "workspace:*",
		"tsdown": "catalog:"
	},
	"peerDependencies": {
		"vitest": "catalog:test:peer"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"typedoc": "./src/index.ts",
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./mocks": {
			"source": "./src/mockHelpers/index.ts",
			"typedoc": "./src/mockHelpers/index.ts",
			"require": {
				"types": "./dist/mockHelpers/index.d.cts",
				"default": "./dist/mockHelpers/index.cjs"
			},
			"default": {
				"types": "./dist/mockHelpers/index.d.ts",
				"default": "./dist/mockHelpers/index.js"
			}
		}
	},
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/kc-workspace/kcws/tree/main/packages/@kcconfigs/vitest",
	"repository": {
		"type": "git",
		"directory": "@kcconfigs/vitest",
		"url": "git+https://github.com/kc-workspace/kcws.git"
	},
	"author": {
		"name": "Kamontat Chantrachirathumrong",
		"email": "kcws@kc.in.th",
		"url": "https://github.com/kamontat"
	},
	"keywords": [
		"config",
		"typescript",
		"vitest",
		"test"
	],
	"files": [
		"CHANGELOG.json",
		"CHANGELOG.md",
		"dist",
		"src",
		"mocks"
	],
	"engines": {
		"node": ">=14"
	},
	"publishConfig": {
		"access": "public"
	}
}
