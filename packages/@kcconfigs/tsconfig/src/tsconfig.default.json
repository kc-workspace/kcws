{
	"$schema": "https://www.schemastore.org/tsconfig",
	"extends": "./tsconfig.base.json",
	"include": ["../../../../package.json", "../../../../src/**/*.ts"],
	"exclude": ["../../../../src/**/*.test.ts"],
	"compilerOptions": {
		"rootDir": "../../../..",
		"outDir": "../../../../dist",
		"typeRoots": [
			"../node_modules/@types",
			"../node_modules/@kctypes",
			"../../../../node_modules/@types",
			"../../../../node_modules/@kctypes"
		],

		"verbatimModuleSyntax": true
	}
}
