{
	"name": "@kcconfigs/tsconfig",
	"version": "1.0.3",
	"description": "Shared tsconfig.json",
	"scripts": {
		"fix": "biome check --fix --unsafe",
		"format": "biome format --fix",
		"format:check": "biome format",
		"lint": "biome lint --fix --unsafe",
		"lint:check": "biome lint"
	},
	"dependencies": {
		"@types/node": "catalog:",
		"@kctypes/generic": "workspace:*"
	},
	"devDependencies": {
		"@kcconfigs/biome": "workspace:*",
		"@biomejs/biome": "catalog:"
	},
	"peerDependencies": {
		"typescript": "catalog:peer"
	},
	"main": "./src/presets/default.json",
	"exports": {
		".": "./src/presets/default.json",
		"./*": "./src/presets/*.json",
		"./envs/*": "./src/envs/*.json",
		"./features/*": "./src/features/*.json"
	},
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/kc-workspace/kcws/tree/main/packages/@kcconfigs/tsconfig",
	"repository": {
		"type": "git",
		"directory": "@kcconfigs/tsconfig",
		"url": "git+https://github.com/kc-workspace/kcws.git"
	},
	"author": {
		"name": "Kamontat Chantrachirathumrong",
		"email": "kcws@kc.in.th",
		"url": "https://github.com/kamontat"
	},
	"keywords": [
		"config",
		"typescript",
		"tsconfig"
	],
	"files": [
		"CHANGELOG.json",
		"CHANGELOG.md",
		"src"
	],
	"engines": {
		"node": ">=14"
	},
	"publishConfig": {
		"access": "public"
	}
}
