{
	"name": "@kcconfigs/tsconfig",
	"version": "1.1.5",
	"description": "Shared tsconfig.json",
	"scripts": {
		"fix": "biome check --fix --unsafe",
		"fix:lint": "biome lint --fix --unsafe",
		"fix:format": "biome format --fix",
		"check": "pnpm run check:lint && pnpm run check:format",
		"check:lint": "biome lint",
		"check:format": "biome format"
	},
	"dependencies": {
		"@types/bun": "^1.3.14",
		"@types/node": "^24.0.0",
		"@kctypes/generic": "workspace:*"
	},
	"devDependencies": {
		"@kcconfigs/biome": "workspace:*",
		"@biomejs/biome": "2.5.10"
	},
	"peerDependencies": {
		"typescript": "^6.0.0",
		"@types/bun": "^1.3.14",
		"@types/node": "^24.0.0",
		"@kctypes/generic": "workspace:*"
	},
	"peerDependenciesMeta": {
		"@types/bun": {
			"optional": true
		},
		"@types/node": {
			"optional": true
		},
		"@kctypes/generic": {
			"optional": true
		}
	},
	"main": "./src/presets/default.json",
	"exports": {
		".": "./src/presets/default.json",
		"./*": "./src/presets/*.json",
		"./envs/*": "./src/envs/*.json",
		"./features/*": "./src/features/*.json"
	},
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/kc-workspace/kcws/tree/main/packages/@kcconfigs/tsconfig",
	"repository": {
		"type": "git",
		"directory": "@kcconfigs/tsconfig",
		"url": "git+https://github.com/kc-workspace/kcws.git"
	},
	"author": {
		"name": "Kamontat Chantrachirathumrong",
		"email": "kcws@kc.in.th",
		"url": "https://github.com/kamontat"
	},
	"keywords": [
		"config",
		"typescript",
		"tsconfig"
	],
	"files": [
		"CHANGELOG.json",
		"CHANGELOG.md",
		"src"
	],
	"engines": {
		"node": ">=14"
	},
	"publishConfig": {
		"access": "public"
	}
}
