{
	"name": "@kcconfigs/tsdown",
	"version": "0.2.7",
	"description": "Shared tsdown configuration",
	"type": "module",
	"scripts": {
		"build": "tsdown --config-loader unrun",
		"test": "vitest run",
		"fix": "biome check --fix --unsafe",
		"fix:lint": "biome lint --fix --unsafe",
		"fix:format": "biome format --fix",
		"check": "pnpm run check:lint && pnpm run check:format && pnpm run check:type",
		"check:lint": "biome lint",
		"check:format": "biome format",
		"check:type": "tsc --noEmit"
	},
	"dependencies": {
		"@arethetypeswrong/core": "0.18.5",
		"@kcinternals/config-builder": "workspace:*",
		"publint": "0.3.23",
		"tsdown": "0.22.7",
		"unplugin-unused": "0.5.7",
		"unrun": "0.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@kcconfigs/biome": "workspace:*",
		"@kcconfigs/tsconfig": "workspace:*"
	},
	"peerDependencies": {
		"@arethetypeswrong/core": "^0.18.0",
		"publint": "^0.3.0",
		"tsdown": "^0.22.7",
		"unplugin-unused": "^0.5.0",
		"unrun": "^0.3.0"
	},
	"peerDependenciesMeta": {
		"publint": {
			"optional": true
		},
		"unplugin-unused": {
			"optional": true
		},
		"@arethetypeswrong/core": {
			"optional": true
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"typedoc": "./src/index.ts",
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./plugins": {
			"source": "./src/plugins/index.ts",
			"typedoc": "./src/plugins/index.ts",
			"require": {
				"types": "./dist/plugins/index.d.cts",
				"default": "./dist/plugins/index.cjs"
			},
			"default": {
				"types": "./dist/plugins/index.d.ts",
				"default": "./dist/plugins/index.js"
			}
		},
		"./plugins/*": {
			"source": "./src/plugins/*.ts",
			"typedoc": "./src/plugins/*.ts",
			"require": {
				"types": "./dist/plugins/*.d.cts",
				"default": "./dist/plugins/*.cjs"
			},
			"default": {
				"types": "./dist/plugins/*.d.ts",
				"default": "./dist/plugins/*.js"
			}
		}
	},
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/kc-workspace/kcws/tree/main/packages/@kcconfigs/tsdown",
	"repository": {
		"type": "git",
		"directory": "@kcconfigs/tsdown",
		"url": "git+https://github.com/kc-workspace/kcws.git"
	},
	"author": {
		"name": "Kamontat Chantrachirathumrong",
		"email": "kcws@kc.in.th",
		"url": "https://github.com/kamontat"
	},
	"keywords": [
		"config",
		"typescript",
		"tsdown",
		"library",
		"compiler",
		"bundler"
	],
	"files": [
		"CHANGELOG.json",
		"CHANGELOG.md",
		"dist",
		"src",
		"!*.test.*"
	],
	"engines": {
		"node": ">=14"
	},
	"publishConfig": {
		"access": "public"
	}
}
