{
	"name": "@kcinternals/config-builder",
	"version": "0.2.2",
	"description": "A config builder for @kc packages using plugin system",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"test": "vitest run --configLoader native",
		"fix": "biome check --fix --unsafe",
		"fix:lint": "biome lint --fix --unsafe",
		"fix:format": "biome format --fix",
		"check": "pnpm run check:lint && pnpm run check:format && pnpm run check:type",
		"check:lint": "biome lint",
		"check:format": "biome format",
		"check:type": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@kcconfigs/biome": "workspace:*",
		"@kcconfigs/tsconfig": "workspace:*",
		"tsdown": "0.22.7",
		"vitest": "4.1.10"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"typedoc": "./src/index.ts",
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/kc-workspace/kcws/tree/main/packages/@kcinternals/config-builder",
	"repository": {
		"type": "git",
		"directory": "@kcinternals/config-builder",
		"url": "git+https://github.com/kc-workspace/kcws.git"
	},
	"author": {
		"name": "Kamontat Chantrachirathumrong",
		"email": "kcws@kc.in.th",
		"url": "https://github.com/kamontat"
	},
	"keywords": [
		"config",
		"builder",
		"plugin",
		"kcconfigs"
	],
	"files": [
		"CHANGELOG.json",
		"CHANGELOG.md",
		"dist",
		"src",
		"!*.test.*"
	],
	"engines": {
		"node": ">=14"
	},
	"publishConfig": {
		"access": "public"
	}
}
