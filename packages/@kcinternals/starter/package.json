{
	"name": "@kcinternals/starter",
	"version": "0.1.0-beta.0",
	"description": "Starter package for creating new packages in KC Workspace",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"fix": "biome check --fix --unsafe",
		"check": "pnpm run lint:check && pnpm run format:check && pnpm run type:check",
		"format": "biome format --fix",
		"format:check": "biome format",
		"lint": "biome lint --fix --unsafe",
		"lint:check": "biome lint",
		"type:check": "tsc --build"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@kcconfigs/biome": "workspace:*",
		"@kcconfigs/vitest": "workspace:*",
		"@kcconfigs/tsconfig": "workspace:*",
		"@kcconfigs/tsdown": "workspace:*",
		"tsdown": "catalog:",
		"vitest": "catalog:test:latest"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"typedoc": "./src/index.ts",
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/kc-workspace/kcws/tree/main/packages/@kcinternals/starter",
	"repository": {
		"type": "git",
		"directory": "@kcinternals/starter",
		"url": "git+https://github.com/kc-workspace/kcws.git"
	},
	"author": {
		"name": "Kamontat Chantrachirathumrong",
		"email": "kcws@kc.in.th",
		"url": "https://github.com/kamontat"
	},
	"keywords": [
		"starter",
		"package",
		"example",
		"tsdown",
		"vitest",
		"biome",
		"typedoc"
	],
	"files": [
		"CHANGELOG.json",
		"CHANGELOG.md",
		"dist",
		"src"
	],
	"engines": {
		"node": ">=14"
	},
	"publishConfig": {
		"access": "public"
	}
}
