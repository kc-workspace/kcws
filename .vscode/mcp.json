{
	"servers": {
		"upstash/context7": {
			"type": "http",
			"url": "https://mcp.context7.com/mcp",
			"headers": {
				"CONTEXT7_API_KEY": "${input:context7_api_key}"
			}
		},
		"cognitionai/deepwiki": {
			"type": "http",
			"url": "https://mcp.deepwiki.com/mcp"
		},
		"oraios/serena": {
			"type": "stdio",
			"command": "mise",
			"args": [
				"exec",
				"pipx:oraios/serena@main",
				"--",
				"serena",
				"start-mcp-server",
				"--context",
				"ide",
				"--project",
				"${workspaceFolder}"
			]
		},
		"modelcontextprotocol/time": {
			"type": "stdio",
			"command": "mise",
			"args": ["exec", "pipx:mcp-server-time@latest", "--", "mcp-server-time"]
		},
		"spences10/sequentialthinking": {
			"type": "stdio",
			"command": "mise",
			"args": [
				"exec",
				"npm:mcp-sequentialthinking-tools@latest",
				"--",
				"mcp-sequentialthinking-tools"
			]
		},
		"github/github-mcp-server": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp"
		}
	},
	"inputs": [
		{
			"id": "context7_api_key",
			"type": "promptString",
			"description": "Context7 API key (optional; increases rate limits). Get one at https://context7.com/dashboard",
			"password": true
		}
	]
}
