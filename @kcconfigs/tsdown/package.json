{
	"name": "@kcconfigs/tsdown",
	"version": "0.1.0-beta.0",
	"description": "TSDown configuration",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"fix": "biome check --fix --unsafe",
		"check": "pnpm run lint:check && pnpm run format:check && pnpm run type:check",
		"format": "biome format --fix",
		"format:check": "biome format",
		"lint": "biome lint --fix --unsafe",
		"lint:check": "biome lint",
		"type:check": "tsc --build"
	},
	"dependencies": {
		"tsdown": "catalog:",
		"publint": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@kctypes/generic": "workspace:*",
		"@kcconfigs/biome": "workspace:*",
		"@kcconfigs/tsconfig": "workspace:*",
		"@vitest/coverage-v8": "catalog:",
		"@vitest/ui": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"publint": "catalog:peer"
	},
	"peerDependenciesMeta": {
		"publint": {
			"optional": true
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"license": "AGPL-3.0-only",
	"homepage": "https://github.com/kc-workspace/kcws/tree/main/@kcconfigs/tsdown",
	"repository": {
		"type": "git",
		"directory": "@kcconfigs/tsdown",
		"url": "git+https://github.com/kc-workspace/kcws.git"
	},
	"author": {
		"name": "Kamontat Chantrachirathumrong",
		"email": "kcws@kc.in.th",
		"url": "https://github.com/kamontat"
	},
	"keywords": [
		"config",
		"typescript",
		"tsdown",
		"library",
		"compiler",
		"bundler"
	],
	"files": [
		"CHANGELOG.json",
		"CHANGELOG.md",
		"dist",
		"src"
	],
	"engines": {
		"node": ">=14"
	},
	"publishConfig": {
		"access": "public"
	}
}
