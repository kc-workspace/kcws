{
	"$schema": "https://www.schemastore.org/tsconfig",
	"extends": "./tsconfig.default.json",
	"include": ["../../../../package.json", "../../../../src/**/*.ts"],
	"exclude": ["../../../../src/**/*.test.ts"],
	"compilerOptions": {
		"incremental": false,
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		"isolatedDeclarations": true,
		"emitDeclarationOnly": true
	}
}
