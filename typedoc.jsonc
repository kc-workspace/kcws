{
	"$schema": "https://typedoc.org/schema.json",

	// Input: https://typedoc.org/documents/Options.Input.html
	"name": "KC's Workspace",
	"entryPointStrategy": "packages",
	"exclude": ["**/*+(index|.e2e).ts"],
	"entryPoints": [
		"./packages/@kcconfigs/tsdown",
		"./packages/@kcconfigs/vitest",
		"./packages/@kcexamples/build"
		// "@kcconfigs/*",
		// "@kcexamples/*",
		// "@kcinternals/*",
		// "@kctools/*",
		// "@kctypes/*",
		// "@kcutils/*",
		// "@kcws/*"
	],
	"out": "docs",
	"includeVersion": false,

	// Output: https://typedoc.org/documents/Options.Output.html
	"emit": "docs",
	"favicon": "assets/docs/favicon.ico",
	"sourceLinkExternal": true,
	"markdownLinkExternal": true,
	"cleanOutputDir": true,
	"visibilityFilters": {
		"protected": true,
		"private": true,
		"inherited": true,
		"external": true,
		"@internal": true,
		"@alpha": true,
		"@beta": true
	},

	// Comments: https://typedoc.org/documents/Options.Comments.html
	"useTsLinkResolution": true,
	"externalSymbolLinkMappings": {
		"rolldown": { "transform": "#" }
	},

	// Organization: https://typedoc.org/documents/Options.Organization.html
	"categorizeByGroup": true,
	"sort": [
		"visibility",
		"static-first",
		"enum-value-ascending",
		"alphabetical"
	],

	// Validation: https://typedoc.org/documents/Options.Validation.html
	"validation": {
		"notExported": true,
		"invalidLink": true,
		"invalidPath": true,
		"rewrittenLink": true,
		"notDocumented": false,
		"unusedMergeModuleWith": true
	},
	"treatWarningsAsErrors": false,
	"treatValidationWarningsAsErrors": false,
	// "requiredToBeDocumented": [
	//   "Namespace",
	//   "Enum",
	//   "EnumMember",
	//   "Function",
	//   "Class",
	//   "Method",
	//   "Reference"
	// ],

	// Other: https://typedoc.org/documents/Options.Other.html

	// Plugins: https://typedoc.org/documents/Plugins.html
	"plugin": [
		"typedoc-theme-oxide",
		"ig-typedoc-theme",
		"typedoc-theme-fresh",
		"varvara-typedoc-theme",
		"typedoc-unhoax-theme",
		"typedoc-github-theme",
		// "typedoc-material-theme",

		"typedoc-plugin-missing-exports",
		"typedoc-plugin-include-example",
		"typedoc-plugin-extras",
		"typedoc-plugin-dt-links",
		"typedoc-plugin-mdn-links"
	],

	// Themes: https://typedoc.org/documents/Themes.html
	// "theme": "default",

	// typedoc-plugin-missing-exports
	// https://github.com/Gerrit0/typedoc-plugin-missing-exports#options
	"internalModule": "[internal]",
	"collapseInternalModule": true,
	"includeDocCommentReferences": true,
	"placeInternalsInOwningModule": false,

	// typedoc-plugin-extras
	// https://github.com/Drarig29/typedoc-plugin-extras#arguments
	"customDescription": "kamontat's workspace for javascript ecosystem",
	"footerTypedocVersion": true,
	"footerLastModified": true,

	// https://github.com/Gerrit0/typedoc-plugin-mdn-links#options
	"resolveUtilityTypes": true
}
